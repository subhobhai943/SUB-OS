// Integer Matrix & Recursive Algorithm Benchmark
// Written in SUB Language (.sb) - Simple Universal Builder

function sub_fib(n) {
    if n <= 1 {
        return n
    }
    return sub_fib(n - 1) + sub_fib(n - 2)
}

function sub_matrix_multiply_test(dim) {
    var total = 0
    var i = 0
    while i < dim {
        var j = 0
        while j < dim {
            var k = 0
            while k < dim {
                total = total + (i * dim + k) * (k * dim + j)
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return total
}

function run_sub_lang_benchmark(iterations) {
    var score = 0
    var fib_result = sub_fib(15) // 610
    var mat_result = sub_matrix_multiply_test(8)

    score = fib_result + (mat_result % 1000) + (iterations * 10)
    return score
}
